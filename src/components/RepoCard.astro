---
import SiteIcon from '@/components/SiteIcon.astro';
import { repoUrl, type Repo } from '@/site.config';

type Props = { repo: Repo; index: number };
const { repo, index } = Astro.props;
---

<div class="reveal" style={`--d:${index % 3}`}>
	<a
		href={repoUrl(repo.name)}
		target="_blank"
		rel="noopener noreferrer"
		class="repo-card group relative flex h-full flex-col justify-between gap-10 rounded-2xl border border-line bg-card p-6"
	>
		<div>
			<div class="mb-6 flex items-center justify-between">
				<span class="font-mono text-[0.68rem] text-faint">{String(index + 1).padStart(2, '0')}</span>
				<span class="grid size-8 place-items-center rounded-full border border-line text-faint transition-colors duration-300 group-hover:border-fg group-hover:bg-fg group-hover:text-canvas">
					<SiteIcon
						name="external"
						class="size-3.5 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:rotate-45"
					/>
				</span>
			</div>
			<h3 class="font-mono text-[0.95rem] break-all text-fg">{repo.name}</h3>
			<p class="mt-3 text-sm leading-relaxed text-mute">{repo.desc}</p>
		</div>
		<div class="flex flex-wrap items-center gap-1.5">
			<span class="chip text-soft">{repo.lang}</span>
			{repo.tags.map((tag) => (
				<span class="chip">{tag}</span>
			))}
		</div>
	</a>
</div>

<style>
	.repo-card {
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.02);
		transition:
			transform var(--dur-hover) var(--ease-out-expo),
			border-color 0.3s ease,
			box-shadow var(--dur-hover) var(--ease-out-expo);
	}

	@media (hover: hover) {
		.repo-card:hover {
			transform: translateY(-4px);
			border-color: var(--line-strong);
			box-shadow: var(--shadow-frame);
		}
	}
</style>
