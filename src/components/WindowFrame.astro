---
import { Image } from 'astro:assets';
import type { Shot } from '@/lib/projectShots';
import mascot from '@/assets/brand/usagi-mascot.svg';

type Props = {
	shot?: Shot;
	title: string;
	eager?: boolean;
	sizes?: string;
	class?: string;
	transitionName?: string;
	// 点击放大，需页面内放置 <Lightbox />
	zoom?: boolean;
};
const {
	shot,
	title,
	eager = false,
	sizes = '(min-width: 768px) 36rem, 100vw',
	class: className,
	transitionName,
	zoom = false,
} = Astro.props;
const Media = zoom ? 'button' : 'div';
const mediaProps =
	zoom && shot
		? {
				type: 'button' as const,
				'data-zoom': `${title} / ${shot.caption}`,
				'aria-label': `放大查看：${shot.caption}`,
				class: 'block w-full cursor-zoom-in',
			}
		: {};
---

<figure
	class:list={['window', className]}
	style={transitionName ? `view-transition-name:${transitionName}` : undefined}
>
	<div class="window-bar">
		<div class="window-dots" aria-hidden="true">
			<span></span>
			<span></span>
			<span></span>
		</div>
		<span class="window-title">
			{title}
			{shot && (
				<>
					<span class="mx-1.5 opacity-50">/</span>
					{shot.caption}
				</>
			)}
		</span>
		<span class="w-[2.675rem] shrink-0" aria-hidden="true"></span>
	</div>
	{shot ? (
		<Media {...mediaProps}>
			<Image
				src={shot.src}
				alt={`${title}：${shot.caption}`}
				widths={[640, 960, 1440, 2048]}
				sizes={sizes}
				loading={eager ? 'eager' : 'lazy'}
				class="block h-auto w-full"
			/>
		</Media>
	) : (
		<div class="relative grid aspect-[16/10] place-items-center overflow-hidden">
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,var(--moon-glow),transparent_60%)]" />
			<div class="relative flex flex-col items-center gap-4">
				<Image src={mascot} draggable="false" alt="" class="size-16 opacity-80" />
				<span class="label-cn">截图整理中</span>
			</div>
		</div>
	)}
</figure>
