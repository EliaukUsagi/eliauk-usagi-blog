<button
	type="button"
	data-theme-toggle
	class="relative grid size-9 place-items-center rounded-full text-mute transition hover:bg-fg/5 hover:text-fg"
	aria-label="切换亮色 / 暗色"
	title="切换亮色 / 暗色"
>
	<svg
		class="theme-sun size-[1.1rem]"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.6"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4" />
		<path
			d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
			stroke-linecap="round"
		/>
	</svg>
	<svg
		class="theme-moon size-[1.05rem]"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.6"
		aria-hidden="true"
	>
		<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round" />
	</svg>
</button>

<style>
	.theme-sun,
	.theme-moon {
		position: absolute;
		transition:
			transform 0.6s var(--ease-out-expo),
			opacity 0.3s ease;
	}

	.theme-moon,
	:global(html[data-theme='dark']) .theme-sun {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}

	:global(html[data-theme='dark']) .theme-moon {
		opacity: 1;
		transform: none;
	}
</style>

<script>
	const root = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: dark)');

	const apply = (theme: string) => {
		root.dataset.theme = theme;
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', theme === 'dark' ? '#121110' : '#f5f3ef');
	};

	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
	const DURATION = 700;
	const EASING = 'cubic-bezier(0.65, 0, 0.35, 1)';
	// 遮罩圆从中心到 78% 半径完全不透明，之后渐隐，形成墨色洇开的柔边
	const SOLID = 0.78;
	const softMask = CSS.supports('mask-image', 'radial-gradient(#000, transparent)');

	// fill: forwards 的动画会一直挂在根元素上并作用到下一次过渡的同名伪元素；不能在 finished 后立刻取消
	// （那一帧伪元素还在，会闪出旧画面），所以留到下一次过渡开始前再取消
	let lastAnimation: Animation | undefined;
	// 过渡中途再次切换会跳过当前过渡、画面直接跳到终态，所以过渡期间忽略点击
	let running = false;

	// 切到暗色：夜色从按钮处洇开；切回亮色：夜色向按钮处收拢褪去，露出底下的亮色
	const switchTo = async (theme: string, origin: HTMLElement) => {
		if (!document.startViewTransition || reduceMotion.matches) {
			apply(theme);
			return;
		}
		if (running) return;

		const rect = origin.getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
		const collapse = theme === 'light';

		lastAnimation?.cancel();
		root.toggleAttribute('data-theme-switching', true);
		root.toggleAttribute('data-theme-collapsing', collapse);
		running = true;
		const vt = document.startViewTransition(() => apply(theme));

		try {
			await vt.ready;
			let keyframes: Keyframe[];
			if (softMask) {
				// 不透明部分要能盖住最远的角，所以整个遮罩直径按 SOLID 放大
				const size = (radius * 2) / SOLID;
				const mask = {
					maskImage: `radial-gradient(closest-side, #000 ${SOLID * 100}%, transparent)`,
					maskRepeat: 'no-repeat',
				};
				keyframes = [
					{ ...mask, maskSize: '0px 0px', maskPosition: `${x}px ${y}px` },
					{ ...mask, maskSize: `${size}px ${size}px`, maskPosition: `${x - size / 2}px ${y - size / 2}px` },
				];
			} else {
				keyframes = [
					{ clipPath: `circle(0px at ${x}px ${y}px)` },
					{ clipPath: `circle(${radius}px at ${x}px ${y}px)` },
				];
			}
			lastAnimation = root.animate(collapse ? keyframes.reverse() : keyframes, {
				duration: DURATION,
				easing: EASING,
				// 动画结束到快照移除之间若回到初始帧，会闪一下旧画面
				fill: 'forwards',
				pseudoElement: collapse ? '::view-transition-old(root)' : '::view-transition-new(root)',
			});
			await vt.finished;
		} catch {
			// 过渡被浏览器跳过时主题已经切换，无需处理
		} finally {
			running = false;
			root.toggleAttribute('data-theme-switching', false);
			root.toggleAttribute('data-theme-collapsing', false);
		}
	};

	document.querySelectorAll<HTMLElement>('[data-theme-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			localStorage.setItem('theme', next);
			switchTo(next, button);
		});
	});

	// 用户未手动选择时跟随系统
	media.addEventListener('change', (event) => {
		if (!localStorage.getItem('theme')) apply(event.matches ? 'dark' : 'light');
	});
</script>
