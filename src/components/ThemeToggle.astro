<button
	type="button"
	data-theme-toggle
	class="relative grid size-9 place-items-center rounded-full text-mute transition hover:bg-fg/5 hover:text-fg"
	aria-label="切换亮色 / 暗色"
	title="切换亮色 / 暗色"
>
	<svg
		class="theme-sun size-[1.1rem]"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.6"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4" />
		<path
			d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
			stroke-linecap="round"
		/>
	</svg>
	<svg
		class="theme-moon size-[1.05rem]"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.6"
		aria-hidden="true"
	>
		<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" stroke-linejoin="round" />
	</svg>
</button>

<style>
	.theme-sun,
	.theme-moon {
		position: absolute;
		transition:
			transform 0.6s var(--ease-out-expo),
			opacity 0.3s ease;
	}

	.theme-moon,
	:global(html[data-theme='dark']) .theme-sun {
		opacity: 0;
		transform: rotate(-90deg) scale(0.6);
	}

	:global(html[data-theme='dark']) .theme-moon {
		opacity: 1;
		transform: none;
	}
</style>

<script>
	const root = document.documentElement;
	const media = matchMedia('(prefers-color-scheme: dark)');

	const apply = (theme: string) => {
		root.dataset.theme = theme;
		document
			.querySelector('meta[name="theme-color"]')
			?.setAttribute('content', theme === 'dark' ? '#0f0f11' : '#f7f7f5');
	};

	document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
		button.addEventListener('click', () => {
			const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
			localStorage.setItem('theme', next);
			apply(next);
		});
	});

	// 用户未手动选择时跟随系统
	media.addEventListener('change', (event) => {
		if (!localStorage.getItem('theme')) apply(event.matches ? 'dark' : 'light');
	});
</script>
