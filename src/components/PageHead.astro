---
import Eyebrow from '@/components/Eyebrow.astro';

// 一级页面（作品 / 随笔）共用的页头，保证标题层级与节奏一致
type Props = { en: string; title: string; desc?: string };
const { en, title, desc } = Astro.props;
---

<header>
	<Eyebrow en={en} class="rise mb-6" style="--d:0" />
	<h1 class="rise display text-5xl leading-display text-fg md:text-display-xl" style="--d:1">
		{title}
	</h1>
	{desc && (
		<p class="rise mt-6 max-w-xl text-lg leading-body text-mute" style="--d:2">
			{desc}
		</p>
	)}
	<slot />
</header>
