---
import type { CollectionEntry } from 'astro:content';
import SiteIcon from '@/components/SiteIcon.astro';
import WindowFrame from '@/components/WindowFrame.astro';
import ShotCarousel from '@/components/ShotCarousel.astro';
import { getShotGroups } from '@/lib/projectShots';

type Props = { project: CollectionEntry<'projects'>; index: number };
const { project, index } = Astro.props;
const { data } = project;
// 首页轮播最多取 6 张，跨分组按顺序排列
const shots = getShotGroups(data.shots)
	.flatMap((group) => group.shots)
	.slice(0, 6);
const flip = index % 2 === 1;
const href = `/projects/${project.id}`;
// 与详情页头图同名，跨页跳转时窗口做共享元素过渡
const transitionName = `project-${project.id}`;
const archived = data.status === '已归档';
const lift = 'transition duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:-translate-y-1.5';
---

<article id={project.id} class="group grid scroll-mt-28 items-center gap-10 lg:grid-cols-12 lg:gap-16">
	<div class:list={['lg:col-span-5', flip && 'lg:order-2']}>
		<div class="reveal mb-8 flex items-center gap-3 font-mono text-xs tracking-wider">
			<span class:list={['status', archived && 'is-archived']}>{data.status}</span>
			<span class="text-mute">{data.year}</span>
			<span class="h-px flex-1 bg-line"></span>
		</div>

		<h3 class="reveal display text-[2rem] leading-[1.1] text-fg md:text-[2.5rem]" style="--d:1">
			<a href={href} class="link-underline">
				{data.title}
			</a>
		</h3>
		<p class="reveal mt-3 text-[0.95rem] font-medium text-soft" style="--d:2">
			{data.subtitle}
		</p>
		<p class="reveal mt-5 max-w-[34rem] text-[0.95rem] leading-[1.85] text-mute" style="--d:3">
			{data.summary}
		</p>

		{/* 技术栈用分隔列表而非整排胶囊，长栈不至于换成三四行抢走标题的视觉重心 */}
		<ul
			class="reveal mt-7 flex max-w-[34rem] flex-wrap items-center gap-y-1.5 border-t border-line pt-5 text-[0.8rem] text-soft"
			style="--d:4"
		>
			{data.stack.map((tech, i) => (
				<li class="inline-flex items-center">
					{i > 0 && <span class="mx-2.5 size-[3px] rounded-full bg-faint" aria-hidden="true"></span>}
					{tech}
				</li>
			))}
		</ul>

		<div class="reveal mt-9 flex flex-wrap items-center gap-6 text-sm" style="--d:5">
			{/* 文字在前、箭头随行：图标与文字同一字号层级，避免大圆圈压过文字 */}
			<a
				href={href}
				class="group/btn inline-flex items-center gap-2 rounded-full border border-line-strong py-2 pr-3.5 pl-4 font-medium text-fg transition-colors duration-300 hover:border-fg hover:bg-fg hover:text-canvas"
			>
				查看详情
				<SiteIcon
					name="arrow"
					class="size-3.5 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover/btn:translate-x-0.5"
				/>
			</a>
			{data.repo && (
				<a
					href={data.repo}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 text-mute transition-colors hover:text-fg"
				>
					<SiteIcon name="github" class="size-3.5" />
					源码
				</a>
			)}
		</div>
	</div>

	<div class:list={['reveal-media lg:col-span-7', flip && 'lg:order-1']} style="--d:1">
		{shots.length > 1 ? (
			<ShotCarousel shots={shots} title={data.title} href={href} transitionName={transitionName} class={lift} />
		) : (
			<a href={href} class="block" aria-label={`查看 ${data.title}`}>
				<WindowFrame
					shot={shots[0]}
					title={data.title}
					sizes="(min-width: 1024px) 44rem, 100vw"
					transitionName={transitionName}
					class={lift}
				/>
			</a>
		)}
	</div>
</article>
