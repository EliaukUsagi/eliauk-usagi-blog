---
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/usagi-mascot.svg';
import policeBadge from '@/assets/brand/police-badge.png';
import SiteIcon from '@/components/SiteIcon.astro';
import { nav, site } from '@/site.config';

const year = new Date().getFullYear();
const { icp, police, policeCode } = site.record;
---

<footer class="relative mt-20 border-t border-line md:mt-24">
	<div class="mx-auto max-w-6xl px-6 pt-14 pb-[calc(5.5rem+env(safe-area-inset-bottom))] md:pt-20 md:pb-12">
		<div class="grid grid-cols-[auto_1fr_auto] gap-x-5 gap-y-6 md:flex md:items-start md:justify-between md:gap-12">
			<div class="contents md:block">
				<p class="reveal label-cn col-span-3 mb-0 flex items-center justify-center gap-4 md:mb-5 md:justify-start">
					<span class="h-px w-16 bg-line md:hidden" aria-hidden="true"></span>
					<span class="whitespace-nowrap">小筑在此，欢迎常来</span>
					<span class="h-px w-16 bg-line md:hidden" aria-hidden="true"></span>
				</p>
				<a
					href="/"
					class="reveal group flex flex-col items-center gap-3 md:flex-row md:items-end md:gap-4"
					style="--d:1"
				>
					<Image
						src={mascot}
						draggable="false"
						alt=""
						class="size-10 transition-transform duration-slower ease-out-expo group-hover:-translate-y-1 group-hover:-rotate-6 sm:size-12"
					/>
					<span class="display text-2xl leading-none text-fg sm:text-3xl md:text-5xl">{site.name}</span>
				</a>
			</div>

			<div class="contents text-sm md:flex md:w-auto md:justify-start md:gap-16">
				<nav aria-label="站内导航" class="reveal justify-self-center" style="--d:2">
					<p class="label-cn mb-3 md:mb-5">站内</p>
					<ul class="flex flex-col gap-3">
						{nav.map((item) => (
							<li>
								<a href={item.href} class="text-mute transition-colors hover:text-fg">
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
				<div class="reveal" style="--d:3">
					<p class="label-cn mb-3 md:mb-5">联系</p>
					<ul class="flex flex-col gap-3">
						<li>
							<a
								href={site.github}
								target="_blank"
								rel="noopener noreferrer"
								class="flex w-fit items-center gap-1.5 text-mute transition-colors hover:text-fg"
							>
								<SiteIcon name="github" class="size-3.5" />
								GitHub
							</a>
						</li>
						{site.email && (
							<li>
								<a
									href={`mailto:${site.email}`}
									class="flex w-fit items-center gap-1.5 text-mute transition-colors hover:text-fg"
								>
									<SiteIcon name="mail" class="size-3.5" />
									邮件
								</a>
							</li>
						)}
					</ul>
				</div>
			</div>
		</div>

		<div class="mt-8 flex flex-col items-start gap-2 border-t border-line pt-5 text-left text-xs text-mute md:mt-16 md:grid md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-6 md:pt-6 md:text-center">
			<p class="md:justify-self-start md:text-left">
				© {site.since}–{year} {site.author} · {site.nameEn}
			</p>
			{/* 备案要求：备案号放在页面底部中间位置，并链接到工信部备案系统 */}
			<div class="flex flex-wrap items-center justify-start gap-x-5 gap-y-2 md:justify-center">
				{icp && (
					<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-fg">
						{icp}
					</a>
				)}
				{police && (
					<a
						href={`https://beian.mps.gov.cn/#/query/webSearch?code=${policeCode}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 hover:text-fg"
					>
						{/* 公安备案要求备案号前带官方图标 */}
						<Image src={policeBadge} alt="" draggable="false" class="h-3.5 w-auto" />
						{police}
					</a>
				)}
			</div>
			{/* 首页月面贴图的来源署名，NASA 要求注明 */}
			<p class="md:justify-self-end md:text-right">
				月面贴图：
				<a href="https://svs.gsfc.nasa.gov/4720" target="_blank" rel="noopener noreferrer" class="hover:text-fg">
					NASA's Scientific Visualization Studio
				</a>
			</p>
		</div>
	</div>
</footer>
