---
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/usagi-mascot.svg';
import policeBadge from '@/assets/brand/police-badge.png';
import SiteIcon from '@/components/SiteIcon.astro';
import { nav, site } from '@/site.config';

const year = new Date().getFullYear();
const { icp, police, policeCode } = site.record;
---

<footer class="relative mt-24 border-t border-line">
	<div class="mx-auto max-w-6xl px-6 pt-20 pb-[calc(7rem+env(safe-area-inset-bottom))] md:pb-12">
		<div class="flex flex-col gap-12 md:flex-row md:items-start md:justify-between">
			<div>
				<p class="reveal label-cn mb-5">— 小筑在此，欢迎常来</p>
				<a href="/" class="reveal group flex items-end gap-4" style="--d:1">
					<Image
						src={mascot}
						draggable="false"
						alt=""
						class="size-12 transition-transform duration-slower ease-out-expo group-hover:-translate-y-1 group-hover:-rotate-6"
					/>
					<span class="display text-4xl leading-none text-fg md:text-5xl">{site.name}</span>
				</a>
			</div>

			<div class="reveal flex gap-16 text-sm" style="--d:2">
				<nav aria-label="站内导航">
					<p class="label-cn mb-5">站内</p>
					<ul class="flex flex-col gap-3">
						{nav.map((item) => (
							<li>
								<a href={item.href} class="text-mute transition-colors hover:text-fg">
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</nav>
				<div>
					<p class="label-cn mb-5">联系</p>
					<ul class="flex flex-col gap-3">
						<li>
							<a
								href={site.github}
								target="_blank"
								rel="noopener noreferrer"
								class="flex w-fit items-center gap-1.5 text-mute transition-colors hover:text-fg"
							>
								<SiteIcon name="github" class="size-3.5" />
								GitHub
							</a>
						</li>
						{site.email && (
							<li>
								<a
									href={`mailto:${site.email}`}
									class="flex w-fit items-center gap-1.5 text-mute transition-colors hover:text-fg"
								>
									<SiteIcon name="mail" class="size-3.5" />
									邮件
								</a>
							</li>
						)}
					</ul>
				</div>
			</div>
		</div>

		<div class="mt-16 flex flex-col items-center gap-2.5 border-t border-line pt-6 text-center text-xs text-mute md:grid md:grid-cols-[1fr_auto_1fr] md:gap-6">
			<p class="md:justify-self-start md:text-left">
				© {site.since}–{year} {site.author} · {site.nameEn}
			</p>
			{/* 备案要求：备案号放在页面底部中间位置，并链接到工信部备案系统 */}
			<div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
				{icp && (
					<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-fg">
						{icp}
					</a>
				)}
				{police && (
					<a
						href={`https://beian.mps.gov.cn/#/query/webSearch?code=${policeCode}`}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 hover:text-fg"
					>
						{/* 公安备案要求备案号前带官方图标 */}
						<Image src={policeBadge} alt="" draggable="false" class="h-3.5 w-auto" />
						{police}
					</a>
				)}
			</div>
			{/* 首页月面贴图的来源署名，NASA 要求注明 */}
			<p class="md:justify-self-end md:text-right">
				月面贴图：
				<a href="https://svs.gsfc.nasa.gov/4720" target="_blank" rel="noopener noreferrer" class="hover:text-fg">
					NASA's Scientific Visualization Studio
				</a>
			</p>
		</div>
	</div>
</footer>
