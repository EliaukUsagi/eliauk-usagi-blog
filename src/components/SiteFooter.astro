---
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/usagi-mascot.svg';
import SiteIcon from '@/components/SiteIcon.astro';
import { nav, site } from '@/site.config';

const year = new Date().getFullYear();
const { icp, police, policeCode } = site.record;
---

<footer class="relative mt-32 border-t border-line">
	<div class="mx-auto max-w-6xl px-6 pt-20 pb-[calc(7rem+env(safe-area-inset-bottom))] md:pb-12">
		<div class="flex flex-col gap-12 md:flex-row md:items-end md:justify-between">
			<div>
				<p class="reveal label mb-5">— 小筑在此，欢迎常来</p>
				<a href="/" class="reveal group flex items-end gap-4" style="--d:1">
					<Image
						src={mascot}
						alt=""
						class="size-16 transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:-translate-y-1 group-hover:-rotate-6"
					/>
					<span class="display text-5xl leading-none text-fg md:text-7xl">{site.name}</span>
				</a>
			</div>

			<div class="reveal grid grid-cols-2 gap-x-14 gap-y-3 text-sm" style="--d:2">
				{nav.map((item) => (
					<a href={item.href} class="w-fit text-mute transition-colors hover:text-fg">
						{item.label}
					</a>
				))}
				<a
					href={site.github}
					target="_blank"
					rel="noopener noreferrer"
					class="flex w-fit items-center gap-1.5 text-mute transition-colors hover:text-fg"
				>
					<SiteIcon name="github" class="size-3.5" />
					GitHub
				</a>
				<a href="/rss.xml" class="flex w-fit items-center gap-1.5 text-mute transition-colors hover:text-fg">
					<SiteIcon name="rss" class="size-3.5" />
					RSS
				</a>
			</div>
		</div>

		<div class="mt-16 flex flex-col gap-3 border-t border-line pt-6 font-mono text-[0.7rem] text-faint md:flex-row md:items-center md:justify-between">
			<p>
				© {site.since}–{year} {site.author} · {site.nameEn}
			</p>
			<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
				{icp && (
					<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="hover:text-mute">
						{icp}
					</a>
				)}
				{police && (
					<a
						href={`https://beian.mps.gov.cn/#/query/webSearch?code=${policeCode}`}
						target="_blank"
						rel="noopener noreferrer"
						class="hover:text-mute"
					>
						{police}
					</a>
				)}
			</div>
		</div>
	</div>
</footer>
