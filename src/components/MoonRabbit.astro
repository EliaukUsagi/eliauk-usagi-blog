---
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/usagi-mascot.svg';
---

<div class="moon-stage relative mx-auto aspect-square w-full max-w-[30rem]" aria-hidden="true">
	<div class="moon-halo absolute inset-[6%] rounded-full"></div>
	<div class="moon-disc absolute inset-[18%] rounded-full"></div>

	<svg class="orbit absolute inset-0 size-full" viewBox="0 0 400 400" fill="none">
		<circle class="ring-soft" cx="200" cy="200" r="188" stroke-dasharray="2 6" />
		<g class="orbit-spin">
			<circle class="ring" cx="200" cy="200" r="160" />
			<circle class="dot-accent" cx="360" cy="200" r="4" />
			<circle class="dot-pine" cx="40" cy="200" r="2.5" />
		</g>
		<g class="orbit-spin-reverse">
			<circle class="ring-soft" cx="200" cy="200" r="128" stroke-dasharray="1 10" />
			<circle class="dot-fg" cx="200" cy="72" r="2.5" />
		</g>
	</svg>

	<div class="rabbit absolute inset-[27%] grid place-items-center">
		<Image src={mascot} alt="" class="w-full drop-shadow-[0_18px_30px_var(--rabbit-shadow)]" loading="eager" />
	</div>

	<span class="coord label absolute top-[8%] left-0">lat 40.84°N</span>
	<span class="coord label absolute right-0 bottom-[10%]">phase · full moon</span>
	<span class="coord label absolute top-1/2 right-[-2%] hidden rotate-90 lg:block">usagi.svg</span>
</div>

<style>
	.moon-halo {
		background: radial-gradient(circle, var(--moon-glow), transparent 68%);
		filter: blur(10px);
	}

	.moon-disc {
		background:
			radial-gradient(circle at 34% 28%, var(--moon-hi), transparent 46%),
			radial-gradient(circle at 70% 70%, var(--moon-crater) 0 6%, transparent 7%),
			radial-gradient(circle at 27% 64%, var(--moon-crater) 0 4%, transparent 5%),
			radial-gradient(circle at 58% 38%, var(--moon-crater) 0 2.5%, transparent 3.5%),
			radial-gradient(circle at 55% 50%, var(--moon-base), var(--moon-edge));
		box-shadow:
			0 0 90px 6px var(--moon-glow),
			inset -20px -26px 60px var(--moon-shade);
	}

	.ring {
		stroke: var(--orbit);
	}

	.ring-soft {
		stroke: var(--orbit-soft);
	}

	.dot-accent {
		fill: var(--accent);
	}

	.dot-pine {
		fill: var(--pine);
	}

	.dot-fg {
		fill: var(--faint);
	}

	.orbit-spin,
	.orbit-spin-reverse {
		transform-origin: 200px 200px;
		animation: spin 48s linear infinite;
	}

	.orbit-spin-reverse {
		animation-duration: 72s;
		animation-direction: reverse;
	}

	.rabbit {
		animation: bob 6s ease-in-out infinite;
	}

	.coord {
		font-size: 0.62rem;
		color: var(--faint);
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	@keyframes bob {
		50% {
			transform: translateY(-8px) rotate(-2deg);
		}
	}
</style>
