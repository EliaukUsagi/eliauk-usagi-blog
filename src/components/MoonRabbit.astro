---
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/usagi-mascot.svg';

// 星点位置固定，避免每次构建产生无意义的 diff
const stars = [
	[12, 18, 1.5, 0],
	[86, 12, 2, 1.2],
	[92, 46, 1.5, 2.4],
	[8, 62, 2, 0.6],
	[22, 88, 1.5, 1.8],
	[78, 90, 2, 3],
	[64, 6, 1.5, 2],
	[4, 34, 1.5, 3.4],
];
---

<div class="moon-stage relative mx-auto aspect-square w-full max-w-[30rem]" aria-hidden="true" data-moon-stage>
	{stars.map(([x, y, s, d]) => (
		<span class="star absolute rounded-full" style={`left:${x}%;top:${y}%;width:${s}px;height:${s}px;animation-delay:${d}s`}></span>
	))}

	<div class="layer" style="--depth:6px;z-index:0">
		<div class="moon-glow absolute inset-[2%] rounded-full"></div>
	</div>

	{/* 轨道后半圈：位于月亮之后 */}
	<div class="layer" style="--depth:4px;z-index:1">
		<div class="orbit-plane">
			<div class="orbit-ring"></div>
		</div>
	</div>

	<div class="layer" style="--depth:10px;z-index:2">
		<div class="moon-disc absolute inset-[16%] rounded-full">
			<span class="crater" style="left:58%;top:30%;width:14%"></span>
			<span class="crater" style="left:24%;top:56%;width:10%"></span>
			<span class="crater" style="left:66%;top:66%;width:8%"></span>
			<span class="crater" style="left:40%;top:20%;width:5%"></span>
		</div>
	</div>

	{/* 轨道前半圈：只露出下半弧，压在月亮上形成环绕的纵深 */}
	<div class="layer" style="--depth:4px;z-index:3">
		<div class="orbit-plane orbit-front">
			<div class="orbit-ring"></div>
		</div>
	</div>

	{/* 卫星单独一层，z-index 随公转在月亮前后切换 */}
	<div class="layer satellite-layer" style="--depth:4px">
		<div class="orbit-plane">
			<div class="satellite-spin">
				<span class="satellite"></span>
			</div>
		</div>
	</div>

	<div class="layer" style="--depth:18px;z-index:5">
		<div class="rabbit absolute bottom-[6%] left-[4%] w-[40%]">
			<Image src={mascot} alt="" class="w-full" loading="eager" />
		</div>
		<div class="bubble glass absolute bottom-[40%] left-[36%] rounded-2xl rounded-bl-md px-3.5 py-2 text-xs text-soft">
			嗨，我是 <span class="font-medium text-fg">Usagi</span>
		</div>
	</div>
</div>

<script>
	// 指针视差：只在可悬停且未要求减弱动态时启用，各层按 --depth 位移
	const stage = document.querySelector<HTMLElement>('[data-moon-stage]');
	const allow =
		window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
		!window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (stage && allow) {
		const host = stage.closest('section') ?? document.body;
		let frame = 0;
		host.addEventListener('pointermove', (event) => {
			cancelAnimationFrame(frame);
			frame = requestAnimationFrame(() => {
				const rect = stage.getBoundingClientRect();
				const x = (event.clientX - (rect.left + rect.width / 2)) / window.innerWidth;
				const y = (event.clientY - (rect.top + rect.height / 2)) / window.innerHeight;
				stage.style.setProperty('--px', x.toFixed(3));
				stage.style.setProperty('--py', y.toFixed(3));
			});
		});
		host.addEventListener('pointerleave', () => {
			stage.style.setProperty('--px', '0');
			stage.style.setProperty('--py', '0');
		});
	}
</script>

<style>
	.moon-stage {
		--px: 0;
		--py: 0;
		--moon-warm: color-mix(in srgb, var(--moon-base) 82%, #e9c89b);
	}

	.layer {
		position: absolute;
		inset: 0;
		translate: calc(var(--px) * var(--depth) * -4) calc(var(--py) * var(--depth) * -4);
		transition: translate 1.2s var(--ease-out-expo);
	}

	.moon-glow {
		background: radial-gradient(circle, color-mix(in srgb, var(--moon-warm) 55%, transparent) 30%, transparent 68%);
		filter: blur(24px);
		opacity: 0.55;
		animation: glow 8s ease-in-out infinite;
	}

	.moon-disc {
		overflow: hidden;
		background:
			radial-gradient(circle at 32% 26%, var(--moon-hi), transparent 42%),
			radial-gradient(circle at 50% 50%, var(--moon-warm) 40%, var(--moon-edge));
		box-shadow:
			inset 0 0 0 1px color-mix(in srgb, var(--moon-hi) 60%, transparent),
			inset -28px -34px 70px var(--moon-shade),
			0 30px 80px -20px var(--rabbit-shadow);
	}

	/* 晨昏线：右下方一道柔和的暗弧，让球体有体积 */
	.moon-disc::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: inherit;
		background: radial-gradient(circle at 18% 14%, transparent 58%, var(--moon-shade) 100%);
	}

	.crater {
		position: absolute;
		aspect-ratio: 1;
		border-radius: 9999px;
		background: radial-gradient(circle at 60% 60%, var(--moon-crater), transparent 70%);
		box-shadow: inset 1px 1px 2px var(--moon-shade);
	}

	.orbit-plane {
		position: absolute;
		inset: 4%;
		transform: rotate(-18deg) scaleY(0.32);
	}

	.orbit-ring {
		position: absolute;
		inset: 0;
		border-radius: 9999px;
		border: 1.5px solid var(--orbit);
	}

	.orbit-front {
		clip-path: inset(50% 0 0 0);
	}

	.orbit-front .orbit-ring {
		border-color: color-mix(in srgb, var(--fg) 22%, transparent);
	}

	.satellite-layer {
		animation: satellite-depth 16s linear infinite;
	}

	.satellite-spin {
		position: absolute;
		inset: 0;
		animation: spin 16s linear infinite;
	}

	/* 平面被 scaleY 压扁，卫星反向拉伸回圆形 */
	.satellite {
		position: absolute;
		top: 50%;
		right: -5px;
		width: 10px;
		height: 10px;
		margin-top: -5px;
		border-radius: 9999px;
		background: var(--accent);
		transform: scaleY(3.125);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
	}

	.rabbit {
		filter: drop-shadow(0 18px 24px var(--rabbit-shadow));
		animation: bob 6s ease-in-out infinite;
		transform-origin: 50% 90%;
	}

	.bubble {
		white-space: nowrap;
		animation: bubble-in 0.9s var(--ease-out-expo) 1.2s both;
	}

	.star {
		background: var(--faint);
		animation: twinkle 4.5s ease-in-out infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* 顺时针公转：前半程经过下方（靠近观者），后半程经过上方（月亮背后） */
	@keyframes satellite-depth {
		0%,
		49.9% {
			z-index: 4;
		}
		50%,
		100% {
			z-index: 1;
		}
	}

	@keyframes bob {
		50% {
			transform: translateY(-8px) rotate(-3deg);
		}
	}

	@keyframes glow {
		50% {
			opacity: 0.85;
		}
	}

	@keyframes twinkle {
		0%,
		100% {
			opacity: 0.2;
		}
		50% {
			opacity: 0.9;
		}
	}

	@keyframes bubble-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.9);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.moon-glow,
		.satellite-layer,
		.satellite-spin,
		.rabbit,
		.bubble,
		.star {
			animation: none;
		}
	}
</style>
