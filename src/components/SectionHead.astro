---
type Props = { title: string; en: string; id?: string };
const { title, en, id } = Astro.props;
---

<div id={id} class="mb-10 flex scroll-mt-28 items-end justify-between gap-6 border-b border-line pb-6">
	<div>
		<p class="reveal label mb-4 flex items-center gap-2.5">
			<span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
			{en}
		</p>
		<h2 class="reveal display text-4xl text-fg md:text-5xl" style="--d:1">
			{title}
		</h2>
	</div>
	<div class="reveal shrink-0 pb-1" style="--d:2">
		<slot />
	</div>
</div>
