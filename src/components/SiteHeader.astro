---
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/usagi-mascot.svg';
import SiteIcon from '@/components/SiteIcon.astro';
import { nav, site } from '@/site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => !href.includes('#') && path.startsWith(href);
---

<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
	<nav
		class="flex w-full max-w-5xl items-center justify-between gap-4 rounded-full border border-line bg-ink/70 py-2 pr-2 pl-3 shadow-[0_10px_40px_-12px_rgb(0_0_0/0.6)] backdrop-blur-xl"
		aria-label="主导航"
	>
		<a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} 首页`}>
			<span class="grid size-9 place-items-center rounded-full bg-cream/10 ring-1 ring-cream/20 transition-transform duration-500 group-hover:-rotate-12">
				<Image src={mascot} alt="" class="size-6" />
			</span>
			<span class="display text-[1.05rem] text-paper">{site.name}</span>
		</a>

		<ul class="hidden items-center gap-1 md:flex">
			{nav.map((item) => (
				<li>
					<a
						href={item.href}
						class:list={[
							'group flex items-baseline gap-1.5 rounded-full px-3.5 py-1.5 text-sm transition-colors',
							isActive(item.href) ? 'bg-paper/8 text-paper' : 'text-mute hover:text-paper',
						]}
					>
						<span class="font-mono text-[0.62rem] text-faint group-hover:text-cream">{item.no}</span>
						{item.label}
					</a>
				</li>
			))}
		</ul>

		<div class="flex items-center gap-1">
			<a
				href={site.github}
				target="_blank"
				rel="noopener noreferrer"
				class="flex items-center gap-2 rounded-full bg-paper px-3.5 py-1.5 text-sm font-medium text-ink transition hover:bg-cream"
			>
				<SiteIcon name="github" class="size-4" />
				<span class="hidden sm:inline">GitHub</span>
			</a>
		</div>
	</nav>
</header>

<nav class="fixed inset-x-0 bottom-4 z-50 flex justify-center px-4 md:hidden" aria-label="移动端导航">
	<ul class="flex gap-1 rounded-full border border-line bg-ink/80 p-1.5 backdrop-blur-xl">
		{nav.map((item) => (
			<li>
				<a
					href={item.href}
					class:list={[
						'block rounded-full px-4 py-1.5 text-sm',
						isActive(item.href) ? 'bg-paper text-ink' : 'text-mute',
					]}
				>
					{item.label}
				</a>
			</li>
		))}
	</ul>
</nav>
