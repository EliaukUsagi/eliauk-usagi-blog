---
import { Image } from 'astro:assets';
import mascot from '@/assets/brand/usagi-mascot.svg';
import SiteIcon from '@/components/SiteIcon.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { nav, site } from '@/site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="site-header fixed inset-x-0 top-4 z-50 flex justify-center px-4">
	<nav
		data-site-nav
		class="site-nav flex w-full items-center justify-between gap-4 rounded-full py-1.5 pr-1.5 pl-2"
		aria-label="主导航"
	>
		<a href="/" class="group flex items-center gap-3" aria-label={`${site.name} 首页`}>
			<span class="logo-mark grid size-10 place-items-center rounded-full">
				<Image
					src={mascot}
					draggable="false"
					alt=""
					class="size-[1.6rem] transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:-rotate-12"
				/>
			</span>
			<span class="flex flex-col leading-none">
				<span class="display text-[1.05rem] text-fg">{site.name}</span>
				<span class="mt-1 font-mono text-[0.62rem] tracking-[0.16em] text-mute uppercase">{site.nameEn}</span>
			</span>
		</a>

		<ul class="hidden items-center gap-0.5 md:flex">
			{nav.map((item) => (
				<li class="relative">
					<a
						href={item.href}
						data-nav-item
						aria-current={isActive(item.href) ? 'page' : undefined}
						class="nav-item relative isolate block rounded-full px-4 py-2 text-sm"
					>
						{isActive(item.href) && <span class="nav-active" aria-hidden="true" />}
						{item.label}
					</a>
				</li>
			))}
		</ul>

		<div class="flex items-center gap-1">
			<ThemeToggle />
			{/* 外链只做图标入口，不在每页最显眼的位置把访客引出站 */}
			<a
				href={site.github}
				target="_blank"
				rel="noopener noreferrer"
				class="grid size-9 place-items-center rounded-full text-mute transition hover:bg-fg/5 hover:text-fg"
				aria-label="GitHub"
				title="GitHub"
			>
				<SiteIcon name="github" class="size-[1.05rem]" />
			</a>
		</div>
	</nav>
</header>

<nav
	data-mobile-nav
	class="mobile-nav fixed inset-x-0 bottom-4 z-50 flex justify-center px-4 md:hidden"
	aria-label="移动端导航"
>
	<ul class="glass flex gap-1 rounded-full p-1.5">
		{nav.map((item) => (
			<li>
				<a
					href={item.href}
					data-nav-item
					aria-current={isActive(item.href) ? 'page' : undefined}
					class="mobile-item block rounded-full px-4 py-1.5 text-sm"
				>
					{item.label}
				</a>
			</li>
		))}
	</ul>
</nav>

<style>
	.site-header {
		view-transition-name: site-header;
	}

	.mobile-nav {
		view-transition-name: mobile-nav;
		bottom: max(1rem, env(safe-area-inset-bottom));
		transition:
			transform 0.4s var(--ease-out-expo),
			opacity 0.3s ease;
	}

	/* 向下滚动阅读时让出屏幕，向上滚动即回来 */
	.mobile-nav[data-hidden] {
		transform: translateY(calc(100% + 2rem));
		opacity: 0;
	}

	.site-nav {
		max-width: 64rem;
		border: 1px solid transparent;
		transition:
			max-width 0.8s var(--ease-out-expo),
			background-color 0.5s ease,
			border-color 0.5s ease,
			box-shadow 0.5s ease;
	}

	/* 页顶时与背景融为一体，滚动后收窄并成为玻璃浮层 */
	.site-nav[data-scrolled] {
		max-width: 52rem;
		border-color: var(--glass-border);
		background: var(--glass-bg);
		box-shadow:
			inset 0 1px 0 var(--glass-hi),
			var(--shadow-nav);
		-webkit-backdrop-filter: blur(20px) saturate(1.6);
		backdrop-filter: blur(20px) saturate(1.6);
	}

	.logo-mark {
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--card) 90%, transparent),
			color-mix(in srgb, var(--sunk) 90%, transparent)
		);
		box-shadow:
			inset 0 0 0 1px var(--line),
			inset 0 1px 0 var(--glass-hi);
	}

	.nav-item,
	.mobile-item {
		color: var(--mute);
		transition:
			color 0.25s ease,
			background-color 0.25s ease;
	}

	/* 悬停只在原位淡入更浅的底色，不移动当前页底色，避免与当前态混淆 */
	.nav-item:hover {
		color: var(--fg);
		background: color-mix(in srgb, var(--fg) 3%, transparent);
	}

	.nav-item[aria-current] {
		color: var(--fg);
		background: transparent;
	}

	/*
	 * 当前页底色单独成块并命名：跨页跳转时由 View Transition 把它从旧菜单项滑到新菜单项，
	 * 悬停不会移动它。移动端菜单项底色是实色，过渡期间会盖住文字，因此不做滑动
	 */
	.nav-active {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--fg) 6%, transparent);
		view-transition-name: nav-active;
	}

	.nav-active::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: 0.2rem;
		width: 4px;
		height: 4px;
		margin-left: -2px;
		border-radius: 50%;
		background: var(--accent);
	}

	.mobile-item {
		transition:
			color 0.3s ease,
			background-color 0.3s ease;
	}

	.mobile-item[aria-current] {
		background: var(--fg);
		color: var(--canvas);
	}
</style>

<script>
	const navEl = document.querySelector<HTMLElement>('[data-site-nav]');
	if (navEl) {
		const onScroll = () => navEl.toggleAttribute('data-scrolled', window.scrollY > 24);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
	}

	// 移动端底部导航：下滚超过一定距离后隐藏，上滚或回到页顶时显示
	const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
	if (mobileNav) {
		let lastY = window.scrollY;
		window.addEventListener(
			'scroll',
			() => {
				const y = window.scrollY;
				if (Math.abs(y - lastY) < 8) return;
				mobileNav.toggleAttribute('data-hidden', y > lastY && y > 160);
				lastY = y;
			},
			{ passive: true },
		);
	}
</script>
