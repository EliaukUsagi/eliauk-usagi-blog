---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import { formatDate } from '@/lib/formatDate';
import { readingMinutes, sortByDate } from '@/lib/postMeta';

export async function getStaticPaths() {
	const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortByDate);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

type Props = {
	post: CollectionEntry<'posts'>;
	newer?: CollectionEntry<'posts'>;
	older?: CollectionEntry<'posts'>;
};
const { post, newer, older } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const project = data.project ? await getEntry('projects', data.project) : undefined;
---

<BaseLayout title={data.title} description={data.description}>
	<div class="read-progress" aria-hidden="true"></div>

	<article class="mx-auto max-w-6xl px-6 pt-40">
		<a href="/posts" class="rise label mb-12 inline-flex items-center gap-2 hover:text-fg" style="--d:0">
			<SiteIcon name="arrow" class="size-3.5 rotate-180" /> 全部随笔
		</a>

		<header class="max-w-3xl">
			<div class="rise flex flex-wrap items-center gap-3 font-mono text-xs text-faint" style="--d:1">
				<span class="rounded-full border border-accent/30 bg-accent/8 px-2.5 py-1 text-accent">{data.category}</span>
				<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
				<span>· 约 {readingMinutes(post.body)} 分钟</span>
			</div>
			<h1 class="rise display mt-6 text-4xl leading-[1.12] text-fg md:text-6xl" style="--d:2">
				{data.title}
			</h1>
			<p class="rise mt-6 text-lg leading-relaxed text-mute md:text-xl" style="--d:3">
				{data.description}
			</p>
			{data.tags.length > 0 && (
				<ul class="rise mt-8 flex flex-wrap gap-2" style="--d:4">
					{data.tags.map((tag) => (
						<li class="font-mono text-[0.7rem] text-faint">#{tag}</li>
					))}
				</ul>
			)}
		</header>

		<div class="mt-16 grid gap-16 border-t border-line pt-14 xl:grid-cols-[minmax(0,48rem)_1fr]">
			<div class="rise article-body prose prose-lg max-w-none" style="--d:5">
				<Content />
			</div>

			{toc.length > 1 && (
				<aside class="hidden xl:block">
					<nav class="sticky top-32" aria-label="目录">
						<p class="label mb-5">目录</p>
						<ol class="space-y-1 border-l border-line">
							{toc.map((h) => (
								<li>
									<a href={`#${h.slug}`} data-toc-link={h.slug} class="toc-link">
										{h.text}
									</a>
								</li>
							))}
						</ol>
					</nav>
				</aside>
			)}
		</div>

		{project && (
			<a
				href={`/projects/${project.id}`}
				class="group mt-20 flex max-w-3xl items-center justify-between gap-6 rounded-2xl border border-line bg-card px-7 py-6 transition duration-500 hover:border-line-strong"
			>
				<div>
					<p class="label mb-2">相关作品</p>
					<p class="display text-2xl text-fg transition-colors group-hover:text-accent">{project.data.title}</p>
					<p class="mt-1 text-sm text-mute">{project.data.subtitle}</p>
				</div>
				<SiteIcon
					name="arrow"
					class="size-5 shrink-0 text-faint transition duration-500 group-hover:translate-x-1 group-hover:text-accent"
				/>
			</a>
		)}

		<nav class="mt-24 grid gap-4 border-t border-line pt-10 md:grid-cols-2" aria-label="更多随笔">
			{older ? (
				<a href={`/posts/${older.id}`} class="group rounded-2xl p-5 transition hover:bg-fg/[0.035] md:-ml-5">
					<p class="label mb-3 flex items-center gap-2">
						<SiteIcon name="arrow" class="size-3.5 rotate-180" /> 上一篇
					</p>
					<p class="display text-2xl text-fg transition-colors group-hover:text-accent">{older.data.title}</p>
				</a>
			) : (
				<span />
			)}
			{newer && (
				<a href={`/posts/${newer.id}`} class="group rounded-2xl p-5 text-right transition hover:bg-fg/[0.035] md:-mr-5">
					<p class="label mb-3 flex items-center justify-end gap-2">
						下一篇 <SiteIcon name="arrow" class="size-3.5" />
					</p>
					<p class="display text-2xl text-fg transition-colors group-hover:text-accent">{newer.data.title}</p>
				</a>
			)}
		</nav>
	</article>
</BaseLayout>

<style>
	/* 阅读进度：用滚动驱动动画，不支持的浏览器不显示 */
	.read-progress {
		display: none;
	}

	@supports (animation-timeline: scroll()) {
		.read-progress {
			display: block;
			position: fixed;
			inset: 0 0 auto;
			z-index: 70;
			height: 2px;
			background: var(--accent);
			transform-origin: left;
			animation: read linear both;
			animation-timeline: scroll(root);
		}
	}

	@keyframes read {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	.toc-link {
		display: block;
		margin-left: -1px;
		padding: 0.35rem 0 0.35rem 1rem;
		border-left: 1px solid transparent;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--faint);
		transition:
			color 0.3s ease,
			border-color 0.3s ease;
	}

	.toc-link:hover {
		color: var(--fg);
	}

	.toc-link.is-current {
		color: var(--fg);
		border-left-color: var(--accent);
	}

	.article-body :global(h2) {
		font-family: var(--font-display);
		font-weight: 400;
		scroll-margin-top: 7rem;
	}

	.article-body :global(h2)::before {
		content: '';
		display: block;
		width: 1.5rem;
		height: 2px;
		margin-bottom: 1.1rem;
		background: var(--accent);
	}

	.article-body :global(blockquote) {
		font-style: normal;
		border-left-width: 2px;
		background: color-mix(in srgb, var(--fg) 3%, transparent);
		padding: 0.6rem 1.25rem;
		border-radius: 0 0.75rem 0.75rem 0;
	}

	.article-body :global(blockquote p::before),
	.article-body :global(blockquote p::after) {
		content: none;
	}

	.article-body :global(:not(pre) > code) {
		padding: 0.15rem 0.4rem;
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--fg) 6%, transparent);
		font-size: 0.85em;
		font-weight: 500;
	}

	.article-body :global(:not(pre) > code::before),
	.article-body :global(:not(pre) > code::after) {
		content: none;
	}

	.article-body :global(pre) {
		border: 1px solid var(--line);
		border-radius: 0.9rem;
		font-size: 0.85rem;
	}

	.article-body :global(hr) {
		margin: 3rem auto;
		width: 3rem;
		border-color: var(--line-strong);
	}
</style>

<script>
	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
	if (links.length) {
		const targets = links
			.map((link) => document.getElementById(link.dataset.tocLink ?? ''))
			.filter((el): el is HTMLElement => !!el);

		const setCurrent = (id: string) =>
			links.forEach((link) => link.classList.toggle('is-current', link.dataset.tocLink === id));

		// 视口上部 30% 区域内最后一个越过的标题即为当前章节
		const update = () => {
			const line = window.innerHeight * 0.3;
			let current = targets[0]?.id ?? '';
			for (const el of targets) {
				if (el.getBoundingClientRect().top <= line) current = el.id;
			}
			setCurrent(current);
		};
		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>
