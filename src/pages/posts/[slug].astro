---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import { formatDate } from '@/lib/formatDate';
import { readingMinutes, sortByDate } from '@/lib/postMeta';

export async function getStaticPaths() {
	const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortByDate);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

type Props = {
	post: CollectionEntry<'posts'>;
	newer?: CollectionEntry<'posts'>;
	older?: CollectionEntry<'posts'>;
};
const { post, newer, older } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const project = data.project ? await getEntry('projects', data.project) : undefined;
---

<BaseLayout
	title={data.title}
	description={data.description}
	type="article"
	og={`/og/posts/${post.id}.png`}
	published={data.date}
>
	<div class="read-progress" aria-hidden="true"></div>

	<article class="mx-auto max-w-6xl px-6 pt-40">
		<a
			href="/posts"
			class="rise label-cn group mb-12 inline-flex items-center gap-2 transition-colors hover:text-fg"
			style="--d:0"
		>
			<SiteIcon
				name="arrow"
				class="size-3.5 rotate-180 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:-translate-x-1"
			/>
			全部随笔
		</a>

		<header class="max-w-3xl">
			<div class="rise flex flex-wrap items-center gap-3 text-xs text-mute" style="--d:1">
				<span class="chip border-accent/25 text-accent">{data.category}</span>
				<time class="font-mono" datetime={data.date.toISOString()}>
					{formatDate(data.date)}
				</time>
				<span class="text-faint" aria-hidden="true">
					·
				</span>
				<span>约 {readingMinutes(post.body)} 分钟读完</span>
			</div>
			<h1 class="rise display mt-6 text-4xl leading-[1.12] text-balance text-fg md:text-6xl" style="--d:2">
				{data.title}
			</h1>
			<p class="rise mt-6 text-lg leading-[1.8] text-mute md:text-xl" style="--d:3">
				{data.description}
			</p>
			{data.tags.length > 0 && (
				<ul class="rise mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm text-mute" style="--d:4" aria-label="标签">
					{data.tags.map((tag) => (
						<li>#{tag}</li>
					))}
				</ul>
			)}
		</header>

		<div class="mt-16 grid gap-16 border-t border-line pt-14 xl:grid-cols-[minmax(0,40rem)_1fr] xl:gap-24">
			<div class="rise article-body prose max-w-none md:prose-lg" style="--d:5">
				<Content />
			</div>

			{toc.length > 1 && (
				<aside class="hidden xl:block">
					<nav class="sticky top-32" aria-label="目录">
						<p class="label-cn mb-5">目录</p>
						<ol class="space-y-1 border-l border-line">
							{toc.map((h) => (
								<li>
									<a href={`#${h.slug}`} data-toc-link={h.slug} class="toc-link">
										{h.text}
									</a>
								</li>
							))}
						</ol>
					</nav>
				</aside>
			)}
		</div>

		{project && (
			<a
				href={`/projects/${project.id}`}
				class="related reveal group mt-20 flex max-w-[40rem] items-center justify-between gap-6 rounded-2xl border border-line bg-card px-7 py-6"
			>
				<div>
					<p class="label-cn mb-2">相关作品</p>
					<p class="display text-2xl text-fg">
						<span class="link-underline">{project.data.title}</span>
					</p>
					<p class="mt-1 text-sm text-mute">{project.data.subtitle}</p>
				</div>
				<span class="grid size-10 shrink-0 place-items-center rounded-full border border-line text-faint transition-colors duration-300 group-hover:border-fg group-hover:bg-fg group-hover:text-canvas">
					<SiteIcon
						name="arrow"
						class="size-4 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-0.5"
					/>
				</span>
			</a>
		)}

		<nav class="reveal mt-20 grid gap-4 border-t border-line pt-10 md:grid-cols-2" aria-label="更多随笔">
			{older ? (
				<a
					href={`/posts/${older.id}`}
					class="group rounded-2xl p-5 transition-colors duration-300 hover:bg-fg/[0.03] md:-ml-5"
				>
					<p class="label-cn mb-3 flex items-center gap-2">
						<SiteIcon name="arrow" class="size-3.5 rotate-180" /> 上一篇
					</p>
					<p class="display text-2xl leading-snug text-fg">
						<span class="link-underline">{older.data.title}</span>
					</p>
				</a>
			) : (
				<span />
			)}
			{newer && (
				<a
					href={`/posts/${newer.id}`}
					class="group rounded-2xl p-5 text-right transition-colors duration-300 hover:bg-fg/[0.03] md:-mr-5"
				>
					<p class="label-cn mb-3 flex items-center justify-end gap-2">
						下一篇 <SiteIcon name="arrow" class="size-3.5" />
					</p>
					<p class="display text-2xl leading-snug text-fg">
						<span class="link-underline">{newer.data.title}</span>
					</p>
				</a>
			)}
		</nav>
	</article>
</BaseLayout>

<style>
	.related {
		transition:
			border-color 0.3s ease,
			box-shadow var(--dur-hover) var(--ease-out-expo),
			opacity var(--dur-reveal) var(--ease-out-expo),
			transform var(--dur-reveal) var(--ease-out-expo);
	}

	@media (hover: hover) {
		.related:hover {
			border-color: var(--line-strong);
			box-shadow: var(--shadow-frame);
		}
	}

	/* 阅读进度：用滚动驱动动画，不支持的浏览器不显示 */
	.read-progress {
		display: none;
	}

	@supports (animation-timeline: scroll()) {
		.read-progress {
			display: block;
			position: fixed;
			inset: 0 0 auto;
			z-index: 70;
			height: 2px;
			background: linear-gradient(to right, transparent, var(--accent));
			transform-origin: left;
			animation: read linear both;
			animation-timeline: scroll(root);
		}
	}

	@keyframes read {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	.toc-link {
		display: block;
		margin-left: -1px;
		padding: 0.35rem 0 0.35rem 1rem;
		border-left: 1px solid transparent;
		font-size: 0.85rem;
		line-height: 1.5;
		color: var(--mute);
		transition:
			color 0.3s ease,
			border-color 0.3s ease;
	}

	.toc-link:hover {
		color: var(--fg);
	}

	.toc-link.is-current {
		color: var(--fg);
		border-left-color: var(--accent);
	}

	.article-body :global(h2) {
		font-weight: 600;
		letter-spacing: -0.015em;
		scroll-margin-top: 7rem;
	}

	.article-body :global(h2)::before {
		content: '';
		display: block;
		width: 1.5rem;
		height: 2px;
		margin-bottom: 1.1rem;
		background: var(--accent);
	}

	.article-body :global(blockquote) {
		font-style: normal;
		border-left-width: 2px;
		background: color-mix(in srgb, var(--fg) 3%, transparent);
		padding: 0.6rem 1.25rem;
		border-radius: 0 0.75rem 0.75rem 0;
	}

	.article-body :global(blockquote p::before),
	.article-body :global(blockquote p::after) {
		content: none;
	}

	.article-body :global(:not(pre) > code) {
		padding: 0.15rem 0.4rem;
		border-radius: 0.35rem;
		background: color-mix(in srgb, var(--fg) 6%, transparent);
		font-size: 0.85em;
		font-weight: 500;
	}

	.article-body :global(:not(pre) > code::before),
	.article-body :global(:not(pre) > code::after) {
		content: none;
	}

	.article-body :global(pre) {
		border: 1px solid var(--line);
		border-radius: 0.9rem;
		font-size: 0.85rem;
		line-height: 1.7;
	}

	.article-body :global(p),
	.article-body :global(li) {
		line-height: 1.9;
	}

	.article-body :global(a) {
		text-decoration-thickness: 1px;
		text-underline-offset: 0.25em;
		text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
		transition: text-decoration-color 0.3s ease;
	}

	.article-body :global(a:hover) {
		text-decoration-color: var(--accent);
	}

	/* 以下元素由脚本在运行时插入，必须用 :global 才能命中 */
	.article-body :global(.code-block) {
		position: relative;
		margin: 1.75em 0;
	}

	.article-body :global(.code-block > pre) {
		margin: 0;
	}

	.article-body :global(.code-copy) {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--line-strong);
		border-radius: 0.5rem;
		background: var(--card);
		font-size: 0.72rem;
		color: var(--mute);
		opacity: 0;
		transition:
			opacity 0.2s ease,
			color 0.2s ease;
	}

	.article-body :global(.code-block:hover .code-copy),
	.article-body :global(.code-copy:focus-visible) {
		opacity: 1;
	}

	.article-body :global(.code-copy:hover) {
		color: var(--fg);
	}

	/* 触屏没有悬停，复制按钮常驻 */
	@media (hover: none) {
		.article-body :global(.code-copy) {
			opacity: 1;
		}
	}

	.article-body :global(.heading-anchor) {
		margin-left: 0.4em;
		font-weight: 400;
		color: var(--faint);
		text-decoration: none;
		opacity: 0;
		transition:
			opacity 0.2s ease,
			color 0.2s ease;
	}

	.article-body :global(:is(h2, h3):hover .heading-anchor),
	.article-body :global(.heading-anchor:focus-visible) {
		opacity: 1;
	}

	.article-body :global(.heading-anchor:hover) {
		color: var(--accent);
	}

	.article-body :global(hr) {
		margin: 3rem auto;
		width: 3rem;
		border-color: var(--line-strong);
	}
</style>

<script>
	const body = document.querySelector<HTMLElement>('.article-body');

	// 代码块复制
	body?.querySelectorAll<HTMLPreElement>('pre').forEach((pre) => {
		const wrap = document.createElement('div');
		wrap.className = 'code-block';
		pre.before(wrap);
		wrap.append(pre);

		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'code-copy';
		button.textContent = '复制';
		let timer = 0;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
				button.textContent = '已复制';
			} catch {
				button.textContent = '复制失败';
			}
			clearTimeout(timer);
			timer = window.setTimeout(() => (button.textContent = '复制'), 1600);
		});
		wrap.append(button);
	});

	// 标题锚点：便于直接分享某一节
	body?.querySelectorAll<HTMLHeadingElement>('h2[id], h3[id]').forEach((heading) => {
		const anchor = document.createElement('a');
		anchor.href = `#${heading.id}`;
		anchor.className = 'heading-anchor';
		anchor.textContent = '#';
		anchor.setAttribute('aria-label', `链接到「${heading.textContent}」`);
		heading.append(anchor);
	});

	const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
	if (links.length) {
		const targets = links
			.map((link) => document.getElementById(link.dataset.tocLink ?? ''))
			.filter((el): el is HTMLElement => !!el);

		const setCurrent = (id: string) =>
			links.forEach((link) => link.classList.toggle('is-current', link.dataset.tocLink === id));

		// 视口上部 30% 区域内最后一个越过的标题即为当前章节
		const update = () => {
			const line = window.innerHeight * 0.3;
			let current = targets[0]?.id ?? '';
			for (const el of targets) {
				if (el.getBoundingClientRect().top <= line) current = el.id;
			}
			setCurrent(current);
		};
		update();
		window.addEventListener('scroll', update, { passive: true });
	}
</script>
