---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate } from '@/lib/formatDate';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="随笔" description="Eliauk 的技术随笔与项目记录。">
	<section class="mx-auto max-w-4xl px-6 pt-40">
		<p class="rise label mb-6" style="--d:0">
			<span class="text-cream">03</span> / Writing
		</p>
		<h1 class="rise display text-6xl text-paper md:text-8xl" style="--d:1">
			随笔<span class="text-blush">.</span>
		</h1>
		<p class="rise mt-6 text-lg text-mute" style="--d:2">
			记录做项目时踩过的坑、做过的取舍。
		</p>

		<ul class="mt-20 divide-y divide-line border-y border-line">
			{posts.map((post) => (
				<li class="reveal">
					<a href={`/posts/${post.id}`} class="group block py-9">
						<div class="flex items-center gap-4 font-mono text-xs text-faint">
							<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
							{post.data.tags.map((tag) => (
								<span>#{tag}</span>
							))}
						</div>
						<h2 class="display mt-3 text-3xl text-paper transition-colors group-hover:text-cream">{post.data.title}</h2>
						<p class="mt-3 text-mute">{post.data.description}</p>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>
