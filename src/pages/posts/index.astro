---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import PostRow from '@/components/PostRow.astro';
import { categories, categoryHint, sortByDate } from '@/lib/postMeta';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortByDate);
const filters = [
	{ key: 'all', label: '全部', count: posts.length, hint: '大模型应用、工程实践、交互细节，以及代码之外的事' },
	...categories.map((c) => ({
		key: c,
		label: c,
		count: posts.filter((p) => p.data.category === c).length,
		hint: categoryHint[c],
	})),
];
---

<BaseLayout title="随笔" description="EliaukUsagi 的随笔：大模型应用、工程实践、交互细节，以及代码之外的事。">
	<section class="mx-auto max-w-5xl px-6 pt-36 md:pt-40">
		<PageHead en="Writing" title="随笔" desc="做项目时踩过的坑、想明白的事，复盘之后写下来。" />

		<div class="toolbar rise sticky top-[5.25rem] z-30 mt-12 md:top-24" style="--d:3">
			<div
				data-segmented
				class="glass relative flex w-max max-w-full gap-0.5 overflow-x-auto rounded-full p-1 [scrollbar-width:none]"
				role="group"
				aria-label="按分类筛选"
			>
				<span data-thumb class="thumb" aria-hidden="true"></span>
				{filters.map((f, i) => (
					<button
						type="button"
						data-filter={f.key}
						aria-pressed={i === 0 ? 'true' : 'false'}
						data-hint={f.hint}
						class="seg relative z-10 flex shrink-0 items-center gap-1.5 rounded-full px-4 py-1.5 text-sm"
					>
						{f.label}
						<span class="font-mono text-[0.65rem] opacity-60">{f.count}</span>
					</button>
				))}
			</div>
		</div>
		{/* 分类说明直接写在页面上，触屏没有悬停提示 */}
		<p data-hint-text class="rise mt-4 text-sm text-mute" style="--d:3">
			{filters[0].hint}
		</p>

		<div data-post-list class="mt-6">
			{posts.map((post, i) => (
				<div
					data-row
					data-category={post.data.category}
					data-id={post.id}
					class="rise"
					style={`--d:${Math.min(i + 4, 9)}`}
				>
					<PostRow post={post} />
				</div>
			))}
		</div>
		<p data-empty hidden class="py-24 text-center text-mute">
			这个分类暂时还没有文章。
		</p>
	</section>
</BaseLayout>

<style>
	.thumb {
		position: absolute;
		top: 0.25rem;
		left: 0;
		height: calc(100% - 0.5rem);
		border-radius: 9999px;
		background: var(--fg);
		box-shadow: 0 4px 12px -4px color-mix(in srgb, var(--fg) 50%, transparent);
		transition:
			transform 0.6s var(--ease-out-expo),
			width 0.6s var(--ease-out-expo);
	}

	.seg {
		color: var(--mute);
		transition: color 0.35s ease;
	}

	.seg:hover {
		color: var(--fg);
	}

	/* 脚本就绪前由按钮自身承担选中底色，避免白字落在玻璃上 */
	.seg[aria-pressed='true'] {
		background: var(--fg);
		color: var(--canvas);
	}

	[data-ready] .seg[aria-pressed='true'] {
		background: transparent;
	}

	.thumb {
		opacity: 0;
	}

	[data-ready] .thumb {
		opacity: 1;
	}

	/* 列表筛选的同文档过渡：只动文章行，页面其余部分不参与 */
	:global(html[data-filtering]::view-transition-old(root)),
	:global(html[data-filtering]::view-transition-new(root)) {
		animation: none;
	}

	:global(html[data-filtering]::view-transition-group(*)) {
		animation-duration: 0.55s;
	}
</style>

<script>
	const group = document.querySelector<HTMLElement>('[data-segmented]');
	const thumb = document.querySelector<HTMLElement>('[data-thumb]');
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
	const rows = [...document.querySelectorAll<HTMLElement>('[data-row]')];
	const empty = document.querySelector<HTMLElement>('[data-empty]');
	const hint = document.querySelector<HTMLElement>('[data-hint-text]');
	const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	const placeThumb = (btn: HTMLElement) => {
		if (!thumb || !group) return;
		thumb.style.width = `${btn.offsetWidth}px`;
		thumb.style.transform = `translateX(${btn.offsetLeft}px)`;
	};

	const render = (key: string) => {
		let visible = 0;
		rows.forEach((row) => {
			const show = key === 'all' || row.dataset.category === key;
			row.hidden = !show;
			if (show) visible++;
		});
		if (empty) empty.hidden = visible > 0;
		buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === key)));
		const active = buttons.find((b) => b.dataset.filter === key);
		if (hint && active?.dataset.hint) hint.textContent = active.dataset.hint;
	};

	const select = (key: string, animate: boolean) => {
		const btn = buttons.find((b) => b.dataset.filter === key) ?? buttons[0];
		placeThumb(btn);
		const url = new URL(location.href);
		if (key === 'all') url.searchParams.delete('c');
		else url.searchParams.set('c', key);
		history.replaceState(null, '', url);

		if (!animate || reduceMotion || !document.startViewTransition) {
			render(btn.dataset.filter!);
			return;
		}
		// 过渡期间给每一行临时命名，结束后移除，避免影响跨页面切换
		const root = document.documentElement;
		rows.forEach((row) => (row.style.viewTransitionName = `post-${row.dataset.id}`));
		root.toggleAttribute('data-filtering', true);
		const vt = document.startViewTransition(() => render(btn.dataset.filter!));
		vt.finished.finally(() => {
			rows.forEach((row) => row.style.removeProperty('view-transition-name'));
			root.toggleAttribute('data-filtering', false);
		});
	};

	if (thumb) thumb.style.transition = 'none';
	const initial = new URLSearchParams(location.search).get('c') ?? 'all';
	select(buttons.some((b) => b.dataset.filter === initial) ? initial : 'all', false);
	group?.toggleAttribute('data-ready', true);
	requestAnimationFrame(() => thumb?.style.removeProperty('transition'));

	buttons.forEach((btn) => btn.addEventListener('click', () => select(btn.dataset.filter!, true)));
	// 字体加载完成后按钮宽度会变化，重新对齐滑块
	document.fonts?.ready.then(() => {
		const active = buttons.find((b) => b.getAttribute('aria-pressed') === 'true');
		if (active) placeThumb(active);
	});
</script>
