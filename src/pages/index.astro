---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import moonTexture from '@/assets/moon/lroc-color.webp';
import MoonRabbit from '@/components/MoonRabbit.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';
import SectionHead from '@/components/SectionHead.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import PostRow from '@/components/PostRow.astro';
import { sortByDate } from '@/lib/postMeta';
import { site } from '@/site.config';

const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
// 首页只放精选，完整清单在 /projects
const projects = allProjects.slice(0, 2);
// 介绍文案整体放在表达式里：模板中的中文长句会被格式化工具折行，换行会渲染成多余空格
const intro = `一名${site.role}。从前端起步，做过桌面应用和服务端，现在主要做大模型应用：让检索与问答稳定地跑在真实数据上。`;
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortByDate).slice(0, 4);
---

<BaseLayout>
	{/* 月面贴图是首屏最大元素（CSS 背景图），预加载让它不必等样式表解析后才开始下载 */}
	<link slot="head" rel="preload" as="image" href={moonTexture.src} type="image/webp" fetchpriority="high" />
	<section class="relative mx-auto grid grid-cols-1 max-w-6xl items-center gap-10 px-6 pt-32 pb-12 max-sm:overflow-x-clip lg:min-h-[100dvh] lg:grid-cols-12 lg:pb-16">
		<div class="lg:col-span-7">
			<h1 class="display text-[3.4rem] leading-[0.98] text-fg sm:text-7xl lg:text-[5.6rem]">
				<span class="rise block" style="--d:1">
					把想法
				</span>
				<span class="rise block" style="--d:2">
					写成<em class="text-accent not-italic"> 能跑的</em>
				</span>
				<span class="rise block" style="--d:3">
					software<span class="text-accent">.</span>
				</span>
			</h1>

			<p class="rise mt-8 max-w-xl text-lg leading-[1.85] text-mute" style="--d:4">
				你好，我是 <span class="text-fg">{site.author}</span>，{intro}
			</p>

			<div class="rise mt-10 flex flex-wrap items-center gap-4" style="--d:5">
				<a href="/projects" class="btn btn-primary group">
					浏览作品
					<SiteIcon
						name="arrow"
						class="size-4 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-1"
					/>
				</a>
				<a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost font-normal">
					<SiteIcon name="github" class="size-4" />
					github.com/{site.githubUser}
				</a>
			</div>
		</div>

		<div class="rise lg:col-span-5" style="--d:3">
			<MoonRabbit />
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-12">
		<SectionHead id="works" en="Selected Works" title="作品">
			<a href="/projects" class="label-cn group flex items-center gap-2 transition-colors hover:text-fg">
				全部 {allProjects.length} 个{' '}
				<SiteIcon
					name="arrow"
					class="size-3.5 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-1"
				/>
			</a>
		</SectionHead>
		<div class="flex flex-col gap-24">
			{projects.map((project, index) => (
				<ProjectFeature project={project} index={index} />
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-28">
		<SectionHead en="Writing" title="随笔">
			<a href="/posts" class="label-cn group flex items-center gap-2 transition-colors hover:text-fg">
				全部{' '}
				<SiteIcon
					name="arrow"
					class="size-3.5 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-1"
				/>
			</a>
		</SectionHead>
		<div>
			{posts.map((post, i) => (
				<div class="reveal" style={`--d:${i}`}>
					<PostRow post={post} />
				</div>
			))}
		</div>
	</section>
</BaseLayout>
