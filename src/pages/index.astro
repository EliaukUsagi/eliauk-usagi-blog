---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import MoonRabbit from '@/components/MoonRabbit.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';
import RepoCard from '@/components/RepoCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import PostRow from '@/components/PostRow.astro';
import { sortByDate } from '@/lib/postMeta';
import { repos, site } from '@/site.config';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(sortByDate).slice(0, 4);
---

<BaseLayout>
	<section class="relative mx-auto grid min-h-[100dvh] max-w-6xl items-center gap-10 px-6 pt-32 pb-16 lg:grid-cols-12">
		<div class="lg:col-span-7">
			<h1 class="display text-[3.4rem] leading-[0.98] text-fg sm:text-7xl lg:text-[5.6rem]">
				<span class="rise block" style="--d:1">
					把想法
				</span>
				<span class="rise block" style="--d:2">
					写成<em class="text-accent not-italic"> 能跑的</em>
				</span>
				<span class="rise block" style="--d:3">
					software<span class="text-accent">.</span>
				</span>
			</h1>

			<p class="rise mt-8 max-w-xl text-lg leading-[1.85] text-mute" style="--d:4">
				你好，我是 <span class="text-fg">{site.author}</span>，一名{site.role}
				。从前端起步，后来做过桌面应用、写过服务端，最近的大部分时间花在大模型应用上——检索、问答，以及怎样让它们稳定地跑在真实数据上。这里记录做过的项目和一路的笔记。
			</p>

			<div class="rise mt-10 flex flex-wrap items-center gap-4" style="--d:5">
				<a href="/projects" class="btn btn-primary group">
					浏览作品
					<SiteIcon
						name="arrow"
						class="size-4 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-1"
					/>
				</a>
				<a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost font-normal">
					<SiteIcon name="github" class="size-4" />
					github.com/{site.githubUser}
				</a>
			</div>
		</div>

		<div class="rise lg:col-span-5" style="--d:3">
			<MoonRabbit />
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-16">
		<SectionHead id="works" no="01" en="Selected Works" title="作品">
			<a href="/projects" class="label group flex items-center gap-2 transition-colors hover:text-fg">
				全部{' '}
				<SiteIcon
					name="arrow"
					class="size-3.5 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-1"
				/>
			</a>
		</SectionHead>
		<div class="flex flex-col gap-32">
			{projects.map((project, index) => (
				<ProjectFeature project={project} index={index} />
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-36">
		<SectionHead id="open-source" no="02" en="Open Source" title="开源">
			<a
				href={`${site.github}?tab=repositories`}
				target="_blank"
				rel="noopener noreferrer"
				class="label flex items-center gap-2 transition-colors hover:text-fg"
			>
				GitHub <SiteIcon name="external" class="size-3.5" />
			</a>
		</SectionHead>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{repos.map((repo, index) => (
				<RepoCard repo={repo} index={index} />
			))}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-36">
		<SectionHead no="03" en="Writing" title="随笔">
			<a href="/posts" class="label group flex items-center gap-2 transition-colors hover:text-fg">
				全部{' '}
				<SiteIcon
					name="arrow"
					class="size-3.5 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-1"
				/>
			</a>
		</SectionHead>
		<div>
			{posts.map((post, i) => (
				<div class="reveal" style={`--d:${i}`}>
					<PostRow post={post} />
				</div>
			))}
		</div>
	</section>
</BaseLayout>
