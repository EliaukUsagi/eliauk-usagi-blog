---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import WindowFrame from '@/components/WindowFrame.astro';
import { getShotGroups } from '@/lib/projectShots';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, next: projects[(i + 1) % projects.length], siblings: projects },
	}));
}

type Props = {
	project: CollectionEntry<'projects'>;
	next: CollectionEntry<'projects'>;
	siblings: CollectionEntry<'projects'>[];
};
const { project, next, siblings } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const groups = getShotGroups(data.shots);
const [hero, ...rest] = groups.flatMap((g) => g.shots);
const series = data.series ? siblings.filter((p) => p.data.series === data.series) : [];
---

<BaseLayout title={data.title} description={data.summary}>
	<article class="mx-auto max-w-6xl px-6 pt-40">
		<a
			href="/projects"
			class="rise label group mb-10 inline-flex items-center gap-2 transition-colors hover:text-fg"
			style="--d:0"
		>
			<SiteIcon
				name="arrow"
				class="size-3.5 rotate-180 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:-translate-x-1"
			/>
			全部作品
		</a>

		<header class="grid gap-10 lg:grid-cols-12">
			<div class="lg:col-span-8">
				<p class="rise font-mono text-xs tracking-wide text-accent" style="--d:1">
					{data.subtitle}
				</p>
				<h1 class="rise display mt-4 text-5xl leading-[1.02] text-fg md:text-7xl" style="--d:2">
					{data.title}
				</h1>
				<p class="rise mt-6 max-w-2xl text-lg leading-[1.8] text-mute" style="--d:3">
					{data.summary}
				</p>
			</div>
			<div class="rise flex items-end text-sm lg:col-span-4 lg:justify-end" style="--d:4">
				{(data.repo || data.release) && (
					<div class="flex flex-wrap gap-3">
						{data.repo && (
							<a href={data.repo} target="_blank" rel="noopener noreferrer" class="btn btn-primary px-4 py-2">
								<SiteIcon name="github" class="size-4" />
								源码
							</a>
						)}
						{data.release && (
							<a
								href={data.release}
								target="_blank"
								rel="noopener noreferrer"
								class="btn btn-ghost px-4 py-2 font-normal"
							>
								Releases <SiteIcon name="external" class="size-3.5" />
							</a>
						)}
					</div>
				)}
			</div>
		</header>

		<div class="rise mt-16" style="--d:5">
			<WindowFrame
				shot={hero}
				title={data.title}
				eager
				sizes="(min-width: 1152px) 72rem, 100vw"
				transitionName={`project-${project.id}`}
			/>
		</div>

		<div class="mt-24 grid gap-16 lg:grid-cols-12">
			<aside class="lg:col-span-4">
				<div class="lg:sticky lg:top-28">
					<p class="label mb-5">技术栈</p>
					<ul class="flex flex-wrap gap-1.5">
						{data.stack.map((tech) => (
							<li class="chip">{tech}</li>
						))}
					</ul>

					{data.highlights.length > 0 && (
						<>
							<p class="label mt-12 mb-5">亮点</p>
							<ol class="space-y-4">
								{data.highlights.map((item, i) => (
									<li class="flex gap-3 text-sm leading-relaxed text-mute">
										<span class="font-mono text-[0.68rem] text-accent">{String(i + 1).padStart(2, '0')}</span>
										{item}
									</li>
								))}
							</ol>
						</>
					)}

					{series.length > 1 && (
						<>
							<p class="label mt-12 mb-5">版本演进</p>
							<ol class="relative space-y-4 border-l border-line pl-5">
								{series
									.toSorted((a, b) => Number(a.data.year) - Number(b.data.year))
									.map((item) => (
										<li class="relative">
											<span
												class:list={[
													'absolute top-1.5 -left-[1.42rem] size-2 rounded-full',
													item.id === project.id ? 'bg-accent' : 'bg-faint',
												]}
											/>
											<a
												href={`/projects/${item.id}`}
												class:list={['text-sm', item.id === project.id ? 'text-fg' : 'text-mute hover:text-fg']}
											>
												{item.data.title}
											</a>
										</li>
									))}
							</ol>
						</>
					)}
				</div>
			</aside>

			<div class="prose max-w-none md:prose-lg leading-[1.9] lg:col-span-8 prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-accent prose-a:underline-offset-4 prose-blockquote:border-accent/40 prose-blockquote:text-mute prose-strong:text-fg">
				<Content />
			</div>
		</div>

		{groups.length > 0 && rest.length > 0 && (
			<section class="mt-32">
				<p class="reveal label mb-10">
					<span class="text-accent">Gallery</span>
					<span class="mx-2 text-faint">/</span>界面一览
				</p>
				{groups.map((group) => (
					<div class="mb-20">
						{group.label && <h2 class="display reveal mb-8 text-3xl text-fg">{group.label}</h2>}
						<div class="grid items-start gap-8 md:grid-cols-2">
							{group.shots.map((shot, i) => {
								const wide = group.shots.length % 2 === 1 && i === 0;
								return (
									<div class:list={['reveal-media', wide && 'md:col-span-2']} style={`--d:${wide ? 0 : i % 2}`}>
										<WindowFrame
											shot={shot}
											title={data.title}
											sizes={wide ? '(min-width: 1152px) 72rem, 100vw' : undefined}
										/>
									</div>
								);
							})}
						</div>
					</div>
				))}
			</section>
		)}

		{next.id !== project.id && (
			<a
				href={`/projects/${next.id}`}
				class="reveal group mt-32 flex items-end justify-between gap-6 border-t border-line pt-10"
			>
				<div>
					<p class="label mb-4">下一个作品</p>
					<p class="display text-4xl text-fg md:text-6xl">
						<span class="link-underline">{next.data.title}</span>
					</p>
				</div>
				<span class="mb-2 grid size-14 shrink-0 place-items-center rounded-full border border-line-strong text-mute transition-colors duration-300 group-hover:border-fg group-hover:bg-fg group-hover:text-canvas">
					<SiteIcon
						name="arrow"
						class="size-5 transition-transform duration-[var(--dur-hover)] ease-[var(--ease-out-expo)] group-hover:translate-x-1"
					/>
				</span>
			</a>
		)}
	</article>
</BaseLayout>
