---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectFeature from '@/components/ProjectFeature.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="作品" description="Eliauk 的个人作品：桌面应用、知识系统与工程实践。">
	<section class="mx-auto max-w-6xl px-6 pt-40">
		<p class="rise label mb-6" style="--d:0">
			<span class="text-accent">01</span>
			<span class="mx-2 text-faint">/</span>Selected Works
		</p>
		<h1 class="rise display text-6xl text-fg md:text-8xl" style="--d:1">
			作品<span class="text-accent">.</span>
		</h1>
		<p class="rise mt-6 max-w-xl text-lg leading-[1.8] text-mute" style="--d:2">
			有的是从零开始的尝试，有的是推倒重来的第二版。每个作品都附上了当时的思路、取舍和还没解决的问题。
		</p>
		<div class="mt-24 flex flex-col gap-32">
			{projects.map((project, index) => (
				<ProjectFeature project={project} index={index} />
			))}
		</div>
	</section>
</BaseLayout>
