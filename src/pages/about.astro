---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import mascot from '@/assets/brand/usagi-mascot.svg';
import { site } from '@/site.config';

const skills = [
	{ area: 'AI 应用', items: ['RAG', 'Agent 工作流', 'Prompt 工程', '向量检索 / 重排', '评测与可观测'] },
	{ area: '前端', items: ['Vue 3', 'React', 'TypeScript', 'Vite', 'Tailwind CSS', 'Naive UI / Ant Design'] },
	{ area: '桌面', items: ['Tauri 2', 'Rust', 'Electron', 'Web Audio'] },
	{ area: '服务端', items: ['Python', 'FastAPI', 'SQLAlchemy', 'PostgreSQL', 'Node.js'] },
	{ area: '工程化', items: ['pnpm workspace', 'Turborepo', 'ESLint / Prettier', 'Vitest / Pytest', 'Docker / Nginx'] },
];
---

<BaseLayout title="关于" description="关于 Eliauk 与这间小筑。">
	<section class="mx-auto max-w-6xl px-6 pt-40">
		<div class="grid gap-16 lg:grid-cols-12">
			<div class="lg:col-span-7">
				<p class="rise label mb-6" style="--d:0">
					<span class="text-accent">04</span>
					<span class="mx-2 text-faint">/</span>About
				</p>
				<h1 class="rise display text-5xl leading-[1.05] break-words text-fg sm:text-6xl md:text-7xl" style="--d:1">
					嗨，我是 <em class="text-accent">{site.author}</em>
				</h1>
				<p class="rise mt-6 font-mono text-sm text-faint" style="--d:2">
					Eliauk ⇄ kuailE（快乐）· Usagi 是名字 —— 合起来，就是「快乐的 Usagi」
				</p>
				<div class="rise mt-10 space-y-5 text-lg leading-[1.85] text-mute" style="--d:3">
					<p>
						{site.role}。最早写网页；后来想让界面跑在桌面上，学了 Electron；为了更小的体积和更完整的原生能力，又开始学
						Rust 和 Tauri；想弄清楚数据从哪里来，就写起了服务端。这条路不是提前规划的，大多是被一个个具体问题带着走的。
					</p>
					<p>
						这两年，大模型改变了写代码的方式，也改变了软件能做的事。日常开发里，我和 AI
						编程助手一起拆解需求、讨论方案、评审代码；业余时间在做一套知识库问答系统，从文档治理、混合检索到带引用的回答，一点点弄清楚
						RAG 落到真实数据上会遇到哪些问题。
					</p>
					<p>
						我的习惯是先读文档和源码再动手，做完回头复盘，把踩过的坑写成笔记。这里的作品和随笔，就是这些过程的记录，难免有不成熟的地方，欢迎指正。
					</p>
					<p>门口那只兔子是 Usagi，也是我所有项目的吉祥物。</p>
				</div>
				<a
					href={site.github}
					target="_blank"
					rel="noopener noreferrer"
					class="rise btn btn-primary mt-10"
					style="--d:4"
				>
					<SiteIcon name="github" class="size-4" /> 在 GitHub 上找到我
				</a>
			</div>
			<div class="rise relative lg:col-span-5" style="--d:2">
				<div class="relative mx-auto max-w-sm">
					{/* 磨砂卡片后面压一轮月亮，玻璃质感才有内容可透 */}
					<div class="about-moon absolute -top-10 -right-8 size-56 rounded-full" aria-hidden="true"></div>
					<div class="glass relative grid aspect-[4/5] place-items-center overflow-hidden rounded-[2rem]">
						<Image src={mascot} alt="Usagi 兔子" class="about-rabbit relative w-1/2 -rotate-6" />
						<p class="label absolute bottom-6">usagi · since {site.since}</p>
					</div>
				</div>
			</div>
		</div>

		<p class="reveal label mt-32 mb-6">
			<span class="text-accent">Toolbox</span>
			<span class="mx-2 text-faint">/</span>常用技术 · 持续学习中
		</p>
		<div class="reveal grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-5">
			{skills.map((group) => (
				<div class="bg-card p-7">
					<p class="label mb-5 text-fg">{group.area}</p>
					<ul class="space-y-2.5 text-sm text-mute">
						{group.items.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	.about-moon {
		background:
			radial-gradient(circle at 34% 28%, var(--moon-hi), transparent 50%),
			radial-gradient(circle at 55% 50%, var(--moon-base), var(--moon-edge));
		box-shadow: 0 0 80px 10px var(--moon-glow);
		animation: drift 14s ease-in-out infinite;
	}

	.about-rabbit {
		filter: drop-shadow(0 18px 30px var(--rabbit-shadow));
	}

	@keyframes drift {
		50% {
			transform: translate(-12px, 10px);
		}
	}
</style>
