---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import TechMap from '@/components/TechMap.astro';
import mascot from '@/assets/brand/usagi-mascot.svg';
import { site } from '@/site.config';

// 只记录方向的转变，不标年份：每一步都由当时想弄明白的问题引出，并非按时间规划
const path = [
	{ title: '网页', desc: '从 HTML / CSS 写起，后来是 Vue 与 React 的组件化。' },
	{ title: '桌面', desc: '想让界面跑在桌面上，用 Electron 做了第一版播放器。' },
	{ title: 'Rust · Tauri', desc: '为了更小的体积和完整的原生能力，用 Tauri 2 重写。' },
	{ title: '服务端', desc: '想弄清数据从哪里来，写起 FastAPI 与 PostgreSQL。' },
	{ title: 'AI 应用', desc: '和大模型一起写代码，也在做带引用回答的 RAG 系统。' },
];

// 文案整体放进表达式：模板里的中文长句会被格式化工具折行，换行会渲染成多余空格
const intro = `${site.role}。这条路没有提前规划，每一步都源于一个想弄明白的问题：怎样让界面跑在桌面上、怎样把体积做得更小、数据从哪里来。`;

const habits = [
	{ title: '先读再写', desc: '动手之前先读文档和源码，弄清边界与约束，再决定怎么做。' },
	{ title: '与 AI 结对', desc: '和编程助手一起拆需求、讨论方案、评审代码，人负责判断与取舍。' },
	{ title: '复盘成文', desc: '做完回头复盘，把踩过的坑写成笔记，这里的随笔就是这样来的。' },
];

const skills = [
	{ area: 'AI 应用', items: ['RAG', 'Agent 工作流', 'Prompt 工程', '向量检索 / 重排', '评测与可观测'] },
	{ area: '前端', items: ['Vue 3', 'React', 'TypeScript', 'Vite', 'Tailwind CSS', 'Naive UI / Ant Design'] },
	{ area: '桌面', items: ['Tauri 2', 'Rust', 'Electron', 'Web Audio'] },
	{ area: '服务端', items: ['Python', 'FastAPI', 'SQLAlchemy', 'PostgreSQL', 'Node.js'] },
	{ area: '工程化', items: ['pnpm workspace', 'Turborepo', 'ESLint / Prettier', 'Vitest / Pytest', 'Docker / Nginx'] },
];
---

<BaseLayout title="关于" description="关于 Eliauk 与这间小筑。">
	<section class="mx-auto max-w-6xl px-6 pt-36 md:pt-40">
		<div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
			<div class="lg:col-span-7">
				<p class="rise label mb-6 flex items-center gap-2.5" style="--d:0">
					<span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
					About
				</p>
				<h1 class="rise display text-5xl leading-[1.05] break-words text-fg sm:text-6xl md:text-7xl" style="--d:1">
					嗨，我是
					<br />
					<span class="text-accent">{site.author}</span>
				</h1>
				<p class="rise mt-7 inline-flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-mute" style="--d:2">
					<span class="font-mono text-fg">Eliauk</span>
					<span class="text-faint">⇄</span>
					<span class="font-mono">kuailE</span>
					<span>（快乐）</span>
					<span class="mx-1 h-3 w-px bg-line-strong"></span>
					合起来，就是「快乐的 Usagi」
				</p>
				<div class="rise mt-8 max-w-xl space-y-4 text-[1.05rem] leading-[1.9] text-soft" style="--d:3">
					<p>{intro}</p>
					<p class="text-mute">这里的作品和随笔，是这些过程的记录，难免有不成熟的地方，欢迎指正。</p>
				</div>
				<div class="rise mt-10 flex flex-wrap items-center gap-3" style="--d:4">
					<a href={site.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
						<SiteIcon name="github" class="size-4" /> 在 GitHub 上找到我
					</a>
					<a href="/projects" class="btn btn-ghost">
						看看作品
					</a>
				</div>
			</div>

			<div class="rise relative lg:col-span-5" style="--d:2">
				<div class="relative mx-auto max-w-[22rem]">
					{/* 磨砂卡片后面压一轮月亮，玻璃质感才有内容可透 */}
					<div class="about-moon absolute -top-10 -right-8 size-56 rounded-full" aria-hidden="true"></div>
					<div class="glass about-card relative select-none aspect-[4/5] overflow-hidden rounded-[2rem]">
						<div class="flex items-center justify-between px-6 pt-5 font-mono text-[0.68rem] tracking-wider text-mute">
							<span>USAGI.SVG</span>
							<span>{site.nameEn}</span>
						</div>
						<div class="absolute inset-0 grid place-items-center">
							<Image src={mascot} draggable="false" alt="Usagi 兔子" class="about-rabbit w-1/2 -rotate-6" />
						</div>
						<div class="absolute inset-x-5 bottom-5 flex items-center justify-between rounded-2xl border border-line bg-card/70 px-4 py-3">
							<div>
								<p class="text-sm font-medium text-fg">Usagi</p>
								<p class="mt-0.5 text-xs text-mute">所有项目的吉祥物</p>
							</div>
							<span class="font-mono text-xs text-mute">since {site.since}</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-24">
		<div class="mb-12 flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
			<div>
				<p class="reveal label mb-4">
					<span class="text-accent">Path</span>
					<span class="mx-2 text-faint">/</span>一路走来
				</p>
				<h2 class="reveal display text-3xl text-fg md:text-4xl" style="--d:1">
					顺着好奇心，一路往下走
				</h2>
			</div>
		</div>
		<ol class="path relative grid gap-10 md:grid-cols-5 md:gap-6">
			{path.map((step, i) => (
				<li class="reveal relative pl-8 md:pt-10 md:pl-0" style={`--d:${i}`}>
					<span class="path-node" aria-hidden="true" data-last={i === path.length - 1 ? '' : undefined}></span>
					<h3 class="text-lg font-semibold text-fg">{step.title}</h3>
					<p class="mt-2 text-sm leading-[1.8] text-mute">{step.desc}</p>
				</li>
			))}
		</ol>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-24">
		<div class="mb-12 border-b border-line pb-6">
			<p class="reveal label mb-4">
				<span class="text-accent">Habits</span>
				<span class="mx-2 text-faint">/</span>做事的方式
			</p>
			<h2 class="reveal display text-3xl text-fg md:text-4xl" style="--d:1">
				慢一点，但每一步都弄清楚
			</h2>
		</div>
		{/* 不加卡片外框与分栏线，区块标题下的分隔线已经完成分组，栏间靠留白区分 */}
		<ul class="grid gap-10 md:grid-cols-3 md:gap-12">
			{habits.map((habit, i) => (
				<li class="reveal" style={`--d:${i}`}>
					<h3 class="text-xl font-semibold text-fg">{habit.title}</h3>
					<p class="mt-4 text-[0.95rem] leading-[1.85] text-mute">{habit.desc}</p>
				</li>
			))}
		</ul>
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-24">
		<div class="mb-12 flex flex-wrap items-end justify-between gap-4 border-b border-line pb-6">
			<div>
				<p class="reveal label mb-4">
					<span class="text-accent">Toolbox</span>
					<span class="mx-2 text-faint">/</span>常用技术
				</p>
				<h2 class="reveal display text-3xl text-fg md:text-4xl" style="--d:1">
					技术栈地图
				</h2>
			</div>
		</div>
		<TechMap groups={skills} />
	</section>

	<section class="mx-auto max-w-6xl px-6 pt-24">
		<div class="reveal">
			<div class="cta relative overflow-hidden rounded-[2rem] border border-line px-8 py-12 md:px-14 md:py-14">
				{/* 右上角压一轮淡月，延续首页与关于页的月亮意象 */}
				<div
					class="cta-moon pointer-events-none absolute -top-24 -right-16 size-72 rounded-full"
					aria-hidden="true"
				></div>
				<div class="relative grid gap-10 md:grid-cols-[1fr_auto] md:items-end">
					<div>
						<p class="label flex items-center gap-2.5">
							<span class="size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
							Say hi
						</p>
						<h2 class="display mt-5 text-[1.75rem] leading-[1.3] text-fg md:text-[2.4rem]">
							有想法、问题或建议，
							<br />
							欢迎找我聊聊。
						</h2>
						{/* 主行动就是联系方式本身：点击即复制邮箱 */}
						{site.email ? (
							<button
								type="button"
								data-copy={site.email}
								class="group mt-8 inline-flex items-center gap-2.5 font-mono text-lg text-fg md:text-xl"
								aria-label={`复制邮箱 ${site.email}`}
							>
								<SiteIcon name="mail" class="size-5 text-accent" />
								<span class="link-underline">{site.email}</span>
								<span data-copy-tip class="copy-tip font-sans text-xs" aria-live="polite">
									点击复制
								</span>
							</button>
						) : (
							<a
								href={site.github}
								target="_blank"
								rel="noopener noreferrer"
								class="mt-8 inline-flex items-center gap-2.5 font-mono text-lg text-fg md:text-xl"
							>
								<SiteIcon name="github" class="size-5" />
								<span class="link-underline">@{site.githubUser}</span>
							</a>
						)}
					</div>
					{site.email && (
						<a
							href={site.github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 text-sm text-mute transition-colors hover:text-fg"
						>
							<SiteIcon name="github" class="size-4" />
							<span class="link-underline">GitHub @{site.githubUser}</span>
						</a>
					)}
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.about-moon {
		background:
			radial-gradient(circle at 34% 28%, var(--moon-hi), transparent 50%),
			radial-gradient(circle at 55% 50%, var(--moon-base), var(--moon-edge));
		box-shadow: 0 0 80px 10px var(--moon-glow);
		animation: drift 14s ease-in-out infinite;
	}

	/* 左下角一层淡赭红暖光，过渡到右上的卡片底色；全部取主题变量，亮暗主题自动适配 */
	.cta {
		background:
			radial-gradient(40rem 22rem at 0% 100%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
			linear-gradient(135deg, color-mix(in srgb, var(--accent) 6%, var(--card)), var(--card) 45%, var(--sunk));
	}

	.copy-tip {
		color: var(--mute);
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 0.25s ease,
			transform 0.4s var(--ease-out-expo);
	}

	.copy-tip[data-done] {
		color: var(--accent);
	}

	button:hover > .copy-tip,
	button:focus-visible > .copy-tip,
	.copy-tip[data-done] {
		opacity: 1;
		transform: none;
	}

	.cta-moon {
		background:
			radial-gradient(circle at 34% 28%, var(--moon-hi), transparent 50%),
			radial-gradient(circle at 55% 50%, var(--moon-base), var(--moon-edge));
		opacity: 0.55;
		box-shadow: 0 0 80px 10px var(--moon-glow);
	}

	.about-rabbit {
		filter: drop-shadow(0 18px 30px var(--rabbit-shadow));
		transition: transform var(--dur-hover) var(--ease-out-expo);
	}

	@media (hover: hover) {
		.about-card:hover .about-rabbit {
			transform: rotate(-2deg) translateY(-6px);
		}
	}

	/* 路线：移动端为左侧竖线，md 以上为顶部横线，节点落在线上 */
	.path::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 0.3125rem;
		width: 1px;
		background: linear-gradient(to bottom, var(--line-strong), var(--line) 85%, transparent);
	}

	.path-node {
		position: absolute;
		top: 0.25rem;
		left: 0;
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 9999px;
		border: 1.5px solid var(--line-strong);
		background: var(--canvas);
	}

	.path-node[data-last] {
		border-color: var(--accent);
		background: var(--accent);
		box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent);
	}

	@media (min-width: 768px) {
		.path::before {
			top: 0.3125rem;
			bottom: auto;
			left: 0;
			right: 0;
			width: auto;
			height: 1px;
			background: linear-gradient(to right, var(--line-strong), var(--line-strong) 80%, var(--accent));
		}

		.path-node {
			top: 0;
		}
	}

	@keyframes drift {
		50% {
			transform: translate(-12px, 10px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-moon {
			animation: none;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		const tip = button.querySelector<HTMLElement>('[data-copy-tip]');
		let timer = 0;
		button.addEventListener('click', async () => {
			if (!tip) return;
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				tip.textContent = '已复制';
			} catch {
				tip.textContent = '复制失败，请手动选择';
			}
			tip.toggleAttribute('data-done', true);
			clearTimeout(timer);
			timer = window.setTimeout(() => {
				tip.toggleAttribute('data-done', false);
				tip.textContent = '点击复制';
			}, 1600);
		});
	});
</script>
